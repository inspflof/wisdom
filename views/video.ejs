<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="/scripts/video-js.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="../index.css">
    <script src="/scripts/video.js" defer></script>
    <link rel="shortcut icon" href="../assets/icons/favicon.ico" type="image/x-icon">
</head>
<body>
  <div class="video-container">

    <video
      id="my-video"
      class="video-js vjs-default-skin"
      preload="metadata"
      data-setup='{}'
      >
      <source 
      <% if (locals.video) { %>
        src="https://tests.devflo.freeddns.org/tests<%= video.url %>" 
      <% } %>
        type="application/x-mpegURL" 
      />
    </video>
  

    <script src="/scripts/video.min.js"></script>
    <script>
      window.player = videojs("my-video")
    </script>
    <div class="controls">
      <div class="control-btns">
        <img src="../assets/icons/playBtn.svg" class="playBtn">
        <div class="time-container">
          <div class="video-current-time"></div>
          <div> / </div>
          <div class="video-duration"></div>
        </div>
      </div>
      <div class="progressBar">
        <div class="currentTime"></div>
        <div class="seek-bar"></div>
        <div class="buffer"></div>
      </div>
    </div>
  </div>
</body>
</html>