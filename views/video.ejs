<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="/scripts/video-js.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="../video.css">
    <script src="./video.js" defer></script>
</head>
<body>
  <div class="video-container">

    <video
      id="my-video"
      class="video-js vjs-default-skin"
      preload="auto"
      data-setup='{}'
      >
      <source 
      src="https://tests.devflo.freeddns.org/tests/test/playlist.m3u8" 
      type="application/x-mpegURL" 
      />
    </video>
  

    <script src="/scripts/video.min.js"></script>
    <script>
      window.player = videojs("my-video")
    </script>
    <img src="../assets/icons/playBtn.svg" class="playBtn">
    <div class="progressBar">
      <div class="currentTime"></div>
    </div>
  </div>
</body>
</html>